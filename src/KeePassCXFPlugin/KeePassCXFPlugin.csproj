<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>KeePassCXF</RootNamespace>
		<AssemblyName>KeePassCXF</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<OutputPath>..\..\build\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Deterministic>true</Deterministic>
		<Title>KeePassCXF</Title>
		<Description>KeePass plugin for Client Exchange Format (CXF) support.</Description>
		<Product>KeePass Plugin</Product>
	</PropertyGroup>

	<!-- Local dev: build\KeePass.exe (strong-named official build). CI fallback: NuGet (unsigned). -->
	<ItemGroup Condition="Exists('..\..\build\KeePass.exe')">
		<Reference Include="KeePass">
			<HintPath>..\..\build\KeePass.exe</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="!Exists('..\..\build\KeePass.exe')">
		<PackageReference Include="KeePass" Version="2.54.0.23169">
			<IncludeAssets>compile</IncludeAssets>
			<ExcludeAssets>runtime;build;native;contentfiles;analyzers;buildtransitive</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- A running KeePass locks the plugin DLLs this build copies into its plugins folder; close it
			 first. The trailing "exit /b 0" keeps a build with no KeePass running from being flagged. -->
	<Target Name="StopRunningKeePass" BeforeTargets="Build" Condition="'$(BuildingInsideVisualStudio)' == 'true'">
		<Exec Command="taskkill /F /IM KeePass.exe &gt;nul 2&gt;&amp;1 &amp; exit /b 0" />
	</Target>

	<Target Name="CopyToKeePassPlugins" AfterTargets="Build">
		<PropertyGroup>
			<KeePassDevDirectory>$(MSBuildThisFileDirectory)..\..\build\KeePass</KeePassDevDirectory>
		</PropertyGroup>
		<MakeDir Directories="$(KeePassDevDirectory)\plugins" />
		<ItemGroup>
			<PluginOutputFiles Include="$(OutputPath)*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginOutputFiles)"
			DestinationFolder="$(KeePassDevDirectory)\plugins"
			SkipUnchangedFiles="true" />
	</Target>

</Project>
